# Quancrypt ortam değişkenleri. Bu dosya yalnızca YER TUTUCU içerir; gerçek sır yazmayın.
#
# Kullanım:
#   cp .env.example .env
#   .env içindeki her CHANGE_ME değerini kendi ürettiğiniz değerle değiştirin.
#   Parola ve token üretmek için (WSL): openssl rand -hex 24   (salt için: openssl rand -hex 32)
#
# Kurallar:
#   - Değerleri tırnaksız ve boşluksuz yazın (infra/postgres/verify.sh dosyayı satır satır okur).
#   - Rol parolaları yalnızca PostgreSQL'in İLK açılışında (boş pgdata volume'ünde) rollere atanır.
#     Sonradan .env'deki parolayı değiştirmek rolün parolasını değiştirmez; `make db-reset` veya
#     ALTER ROLE gerekir.
#   - .env commit'lenmez (.gitignore'dadır).
#   - .env yoksa veya bir parola boşsa `make up/down/ps/logs/db-reset` dahil tüm compose komutları
#     "required variable ... is missing" hatası verir (docker-compose.yml'deki `:?` zorunluluğu).
#   - `make up` .env'de CHANGE_ME kalmışsa başlamaz; init betiği de CHANGE_ME parolayla açılışı reddeder.

# ---- PostgreSQL (tek konteyner, ayrı veritabanları ve roller; D-09) ----

# PostgreSQL yönetici (postgres) parolası. Yalnızca altyapı işleri kullanır, servisler kullanmaz.
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# core_db: core-service. migrator DDL (migration), app DML (uygulama).
# core_db_migrator rolünün parolası (DDL, migration).
CORE_DB_MIGRATOR_PASSWORD=CHANGE_ME
# core_db_app rolünün parolası (DML, uygulama).
CORE_DB_APP_PASSWORD=CHANGE_ME

# agent_db: agent-service (3NF + pgvector).
# agent_db_migrator rolünün parolası (DDL, migration).
AGENT_DB_MIGRATOR_PASSWORD=CHANGE_ME
# agent_db_app rolünün parolası (DML, uygulama).
AGENT_DB_APP_PASSWORD=CHANGE_ME

# warehouse_db: veri platformu (raw, prep, core, marts).
# warehouse_db_migrator rolünün parolası (DDL, dbt ve migration).
WAREHOUSE_DB_MIGRATOR_PASSWORD=CHANGE_ME
# warehouse_db_app rolünün parolası (DML, ingest ve ön işleme).
WAREHOUSE_DB_APP_PASSWORD=CHANGE_ME

# warehouse_db marts şemasını okuyan salt okunur rol (Superset ve ML).
WAREHOUSE_READER_PASSWORD=CHANGE_ME

# mlflow_db: MLflow.
# mlflow_db_migrator rolünün parolası (DDL, migration).
MLFLOW_DB_MIGRATOR_PASSWORD=CHANGE_ME
# mlflow_db_app rolünün parolası (DML, uygulama).
MLFLOW_DB_APP_PASSWORD=CHANGE_ME

# ---- Anonimleştirme ve servisler arası kimlik ----

# project_key = HMAC-SHA256(QUANCRYPT_ANON_SALT, proje kimliği veya repo adresi). Kaybolursa eski
# anahtarlar yeniden üretilemez; paylaşmayın.
QUANCRYPT_ANON_SALT=CHANGE_ME

# Servisler arası çağrılarda kullanılan iç token.
INTERNAL_SERVICE_TOKEN=CHANGE_ME

# UI oturum token'ı: UI her isteğe `Authorization: Bearer <token>` ekler (core-service ve agent-service, guardrails-security §6).
# En az 32 karakter, INTERNAL_SERVICE_TOKEN'dan farklı (üretmek için: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=').
QUANCRYPT_SESSION_TOKEN=CHANGE_ME

# ---- core-service (compose profili app) ----

# Outbox relay'i varsayılan olarak kapalıdır; olaylar outbox'ta birikir. ingest-api (Faz 6) gelince
# OUTBOX_RELAY_ENABLED=true ve INGEST_API_URL (yalnızca http veya https, kimlik bilgisi içermeden) verilir.
# OUTBOX_RELAY_ENABLED=false
# INGEST_API_URL=http://ingest-api:8084/api/v1/events
# OUTBOX_RELAY_INTERVAL=5s
# OUTBOX_RELAY_BATCH_SIZE=100
# agent-service outbox relay'i de aynı OUTBOX_RELAY_ENABLED ve INGEST_API_URL değerlerini okur (P4.6, D-252g).
# Servisi konteyner dışında çalıştırırken veritabanı adresi (konteynerde compose kendisi verir):
# CORE_DB_URL=jdbc:postgresql://127.0.0.1:5432/core_db

# ---- Ollama (host'ta çalışır; D-51) ----

# Host tarafındaki betiklerin ve `make run`'ın Ollama'ya eriştiği adres. agent-service konteyneri bu değeri kullanmaz: kök
# docker-compose.yml konteynere `http://host.docker.internal:11434` verir (D-219). Ana bilgisayar adı yalnızca localhost,
# 127.0.0.1, ::1, host.docker.internal veya ollama olabilir (Aşama 1 yereldir).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# agent-service: agent_db adresi (yalnızca konteyner dışında çalıştırırken; konteynerde compose kendisi verir). Adreste parola
# yoktur; parolalar yukarıdaki AGENT_DB_APP_PASSWORD ve AGENT_DB_MIGRATOR_PASSWORD değişkenlerinden gelir. Servis açılışta
# migration'ları migrator rolüyle uygular, çalışırken yalnızca uygulama rolüyle bağlanır.
# AGENT_DB_URL=postgresql+psycopg://agent_db_app@127.0.0.1:5432/agent_db
# AGENT_DB_MIGRATOR_URL=postgresql+psycopg://agent_db_migrator@127.0.0.1:5432/agent_db
# agent-service araçlarının çağırdığı servisler (yalnızca konteyner dışında; konteynerde compose `core-service` ve
# `analyzer-service` adlarını verir). İzinli ana bilgisayarlar: localhost, 127.0.0.1, ::1, core-service,
# analyzer-service. Araçlar INTERNAL_SERVICE_TOKEN'ı gönderir (en az 32 karakter).
# CORE_SERVICE_URL=http://127.0.0.1:8081
# ANALYZER_SERVICE_URL=http://127.0.0.1:8082

# agent-service: dil modeli sağlayıcısı, ollama (varsayılan) veya null (LLM'siz mod; açıklama metni "LLM kapalı" notu taşır).
# LLM_PROVIDER=ollama
# agent-service: log düzeyi (DEBUG, INFO, WARNING, ERROR). Varsayılan INFO.
# LOG_LEVEL=INFO

# ---- Analiz edilecek dizinler (analyzer-service'e salt okunur bağlanır) ----

# Analiz edilecek Spring Boot projesinin mutlak yolu (WSL yolu, örneğin /home/kullanici/proje).
PROJECT_ROOT=/absolute/path/to/analyzed-project

# analyzer-service: bir analizin sunucu tarafı zaman bütçesi, saniye (D-199); aşımda 504 analysis-timeout. Varsayılan 300.
# ANALYSIS_TIME_BUDGET_SECONDS=300

# Korpus taraması için klonlanmış projelerin mutlak yolu (P6.2).
CORPUS_ROOT=/absolute/path/to/corpus

# Benchmark veri setlerinin (CryptoAPI-Bench, OWASP Benchmark) bulunduğu klasör (P3.2). Repoya kopyalanmaz, yalnız okunur.
DATASETS_ROOT=/absolute/path/to/datasets
