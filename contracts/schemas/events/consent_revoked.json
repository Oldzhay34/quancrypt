{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quancrypt.local/schemas/events/consent_revoked.json",
  "title": "consent_revoked",
  "description": "Bir onay geri alındı veya proje silindi (RevokeConsent, DeleteProject). Onay durumundan bağımsız olarak HER ZAMAN yazılır. Zarf alanları her olay dosyasında satır içi tekrarlanır (ortak dosya yoktur). Yük yalnızca kodlu alanlar, sayılar ve desenle sınırlı sürüm metinleridir; yol, sembol, kod parçası veya serbest metin içermez (D-20, D-21).",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "consent_revoked"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Proje kimliğinin HMAC-SHA256 özeti (QUANCRYPT_ANON_SALT)."
    },
    "payload": {
      "type": "object",
      "properties": {
        "consent_type": {
          "type": "string",
          "enum": [
            "WAREHOUSE_ANALYTICS",
            "MODEL_TRAINING"
          ]
        },
        "delete_requested": {
          "type": "boolean",
          "description": "true = proje silindi (DeleteProject); warehouse türev veriyi siler."
        }
      },
      "required": [
        "consent_type",
        "delete_requested"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "project_key",
    "payload"
  ],
  "additionalProperties": false
}
