{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quancrypt.local/schemas/events/plan_created.json",
  "title": "plan_created",
  "description": "Bir tarama için geçiş planı oluşturuldu (CreatePlan). Zarf alanları her olay dosyasında satır içi tekrarlanır (ortak dosya yoktur). Yük yalnızca kodlu alanlar, sayılar ve desenle sınırlı sürüm metinleridir; yol, sembol, kod parçası veya serbest metin içermez (D-20, D-21).",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "plan_created"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Proje kimliğinin HMAC-SHA256 özeti (QUANCRYPT_ANON_SALT)."
    },
    "payload": {
      "type": "object",
      "properties": {
        "item_count": {
          "type": "integer",
          "minimum": 1
        },
        "strategy_counts": {
          "type": "object",
          "description": "Strateji koduna göre madde sayısı.",
          "propertyNames": {
            "enum": [
              "FIX_WEAK_CLASSIC",
              "HYBRID_TLS_KEX",
              "KEM_DEM_ENCRYPTION",
              "DEVICE_HYBRID_TLS",
              "PQ_SIGNATURE",
              "KEEP_SHORT_LIVED_TOKEN",
              "HYBRID_KEX_CLASSIC_CERT",
              "JDK_UPGRADE"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "effort_counts": {
          "type": "object",
          "description": "Efor koduna göre madde sayısı.",
          "propertyNames": {
            "enum": [
              "S",
              "M",
              "L"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "item_count",
        "strategy_counts",
        "effort_counts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "project_key",
    "payload"
  ],
  "additionalProperties": false
}
