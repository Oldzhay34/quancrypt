{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kb_search",
  "description": "Knowledge-base search (KnowledgeBase.search): the k closest note chunks that apply to the runtime.",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "java_version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9A-Za-z._+-]{1,32}$"
        },
        "spring_boot_version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9A-Za-z._+-]{1,32}$"
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "hits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "doc_key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_type": {
                "type": "string",
                "enum": [
                  "STANDARD",
                  "JEP",
                  "VENDOR_DOC",
                  "SPECIFICATION",
                  "GOVERNMENT_GUIDANCE",
                  "INTERNAL"
                ]
              },
              "version_tag": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "enum": [
                  "tr",
                  "en"
                ]
              },
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string"
              },
              "distance": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            },
            "required": [
              "doc_key",
              "title",
              "source_url",
              "source_type",
              "version_tag",
              "language",
              "ordinal",
              "text",
              "distance"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "hits"
      ],
      "additionalProperties": false
    }
  }
}
