{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quancrypt.local/schemas/qbank/terminal-transaction.schema.json",
  "title": "QBank terminal transaction",
  "description": "Message published by a QBank field terminal to the MQTT topic terminal/{terminalId}/transactions. The terminalId in the message must equal the {terminalId} segment of the topic; this equality cannot be expressed in JSON Schema and is checked by the consumer. The message carries no card data.",
  "type": "object",
  "required": ["transactionId", "terminalId", "accountId", "amount", "currency", "occurredAt"],
  "properties": {
    "transactionId": {
      "type": "string",
      "format": "uuid"
    },
    "terminalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "examples": ["terminal-001"]
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "description": "Decimal amount with exactly two fractional digits.",
      "examples": ["12.50"]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 alphabetic currency code.",
      "examples": ["TRY"]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp."
    }
  },
  "additionalProperties": false
}
