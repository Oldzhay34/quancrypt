<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!--
    Test sources only. The in-memory database snapshot is a test fixture that copies every table on purpose, so the
    copies it stores and returns are the point of the class. The negative tests call pure domain methods inside
    assertThatThrownBy lambdas only to provoke the exception they assert, so the ignored return value is intended.
  -->
  <Match>
    <Class name="~com\.quancrypt\.core\.fake\.InMemoryDatabase\$Snapshot"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Package name="~com\.quancrypt\.core\.unit\..*"/>
    <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT,RV_RETURN_VALUE_IGNORED_INFERRED"/>
  </Match>
  <!--
    Test wiring holds shared, stateful collaborators on purpose: the port set of the contract tests and the audit
    decorator keep the adapters they are given (as the use cases do, see exclude.xml), and the test database hands out its
    one shared connection pool. Copying them would defeat their purpose.
  -->
  <Match>
    <Or>
      <Class name="com.quancrypt.core.contract.PortSet"/>
      <Class name="com.quancrypt.core.integration.support.ArmedAuditLogWriter"/>
      <Class name="com.quancrypt.core.integration.support.PostgresTestDatabase"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!--
    The HTTP test client and the parsed contract are short-lived value holders of the test code (response bytes and
    headers, operations read from the OpenAPI file); nothing outside the test reads or changes them.
  -->
  <Match>
    <Or>
      <Class name="~com\.quancrypt\.core\.integration\.support\.ApiClient\$.*"/>
      <Class name="~com\.quancrypt\.core\.integration\.support\.OpenApiContract\$Operation"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
